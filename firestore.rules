rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // 2. Hubs collection
    match /hubs/{hubId} {
      allow read, write: if isValidId(hubId);

      // Subcollections for isolated couple data
      match /events/{eventId} {
        allow read, write: if isValidId(hubId) && isValidId(eventId);
      }

      match /stays/{date} {
        allow read, write: if isValidId(hubId) && isValidId(date);
      }

      match /templates/{templateId} {
        allow read, write: if isValidId(hubId) && isValidId(templateId);
      }

      match /messages/{messageId} {
        allow read, write: if isValidId(hubId) && isValidId(messageId);
      }

      match /tasks/{taskId} {
        allow read, write: if isValidId(hubId) && isValidId(taskId);
      }

      match /notifications/{notifId} {
        allow read, write: if isValidId(hubId) && isValidId(notifId);
      }
    }

    // Default deny any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
